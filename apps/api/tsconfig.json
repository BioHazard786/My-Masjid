{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": ["@cloudflare/workers-types"],
    // Make sure composite is true
    "composite": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@api/*": ["./src/*"],
      "@packages/validators": ["../../packages/validators/src/index.ts"],
      "@packages/utils": ["../../packages/utils/src/index.ts"],
      "@packages/*": ["../../packages/*"]
    }
  },
  "include": ["src/**/*", "../../packages/**/*"],
  "exclude": ["node_modules", "dist"]
}
